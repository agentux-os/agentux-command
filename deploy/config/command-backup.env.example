# Copy to /etc/agentux/command-backup.env, owned by root and the account's
# group with mode 0640. Put the Restic password in a separate protected file.

# Use a dedicated Restic repository for AgentUX Command.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/replace-with-bucket/agentux-command
RESTIC_PASSWORD_FILE=/etc/agentux/command-backup-restic-password
# S3-compatible backends can also use operator-managed AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY variables in this protected EnvironmentFile.
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
# AWS_DEFAULT_REGION=us-east-1

# Snapshot retention. Zero disables a period; keep at least one period.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# State and node_exporter textfile collector output (timestamps/counters only).
BACKUP_STATE_DIR=/var/lib/agentux/command/backup-state
BACKUP_STAGING_DIR=/var/lib/agentux/command/backup-state/staging
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/agentux-command-backup.prom
# If Command event retention is enabled, set this to the same in-container
# path as AGENTUX_COMMAND_EVENT_ARCHIVE_DIR in command.env.
# BACKUP_EVENT_ARCHIVE_DIR=/var/lib/agentux-command/archive

# Podman names from deploy/quadlet. Adjust if the bundle was renamed.
ENGINE=podman
COMMAND_CONTAINER=agentux-command
PG_CONTAINER=agentux-command-postgres
BACKUP_VERIFY_DB_START_ATTEMPTS=60
