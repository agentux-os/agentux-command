# Copy to /var/lib/agentux/command/command.env and restrict it to root
# (chmod 600). Replace every placeholder before enabling the Quadlet units.
# The PostgreSQL password is not here: it is a Podman secret.

# Where nodes and browsers reach Command; provision files and the OIDC
# callback use it.
AGENTUX_COMMAND_PUBLIC_URL=https://command.example.invalid

# Operators sign in with an OIDC provider (README: Operator access). Register
# <AGENTUX_COMMAND_PUBLIC_URL>/v1/auth/callback as the client's redirect URI.
#AGENTUX_COMMAND_OIDC_ISSUER=https://id.example.invalid/realms/example
#AGENTUX_COMMAND_OIDC_CLIENT_ID=agentux-command
#AGENTUX_COMMAND_OIDC_CLIENT_SECRET=replace-with-the-client-secret
#AGENTUX_COMMAND_OIDC_ROLES=/var/lib/agentux/command/roles.json

# Events delivered to a webhook, at least once (README: Events).
#AGENTUX_COMMAND_EVENTS_URL=https://events.example.invalid/agentux
#AGENTUX_COMMAND_EVENTS_TOKEN=replace-with-the-webhook-token

# AgentUX Office is served at <AGENTUX_COMMAND_PUBLIC_URL>/office/ from the
# bundle in the image. When operators may see several organizations, the one
# it opens on:
#AGENTUX_COMMAND_OFFICE_ORGANIZATION=acme

# Event retention (deploy/README.md, Event retention): off by default, every
# event is kept. Both set: events older than this many days (at least 30)
# are archived to the directory, then pruned, once a day.
#AGENTUX_COMMAND_EVENT_RETENTION_DAYS=365
#AGENTUX_COMMAND_EVENT_ARCHIVE_DIR=/var/lib/agentux-command/archive

# Nodes enroll with tokens (README: Node enrollment). Static per-node tokens
# are for nodes that cannot enroll: node-id=token,node-id=token.
#AGENTUX_COMMAND_NODE_TOKENS=node-example=replace-with-a-long-random-token
