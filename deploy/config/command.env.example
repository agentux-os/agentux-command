# Copy to /var/lib/agentux/command/command.env and restrict it to root.
# Replace every placeholder before enabling the Quadlet units.
AGENTUX_COMMAND_TAG=0.1.1
AGENTUX_COMMAND_PUBLIC_URL=https://command.example.invalid
AGENTUX_COMMAND_LOG_LEVEL=info
AGENTUX_COMMAND_ENCRYPTION_KEY=replace-with-a-32-byte-secret
# Node id to its bearer token, for AUXP messages from AgentUX nodes
# (aux node enroll on the node). Unset: messages are not authenticated.
AGENTUX_COMMAND_NODE_TOKENS=node-example=change-me
