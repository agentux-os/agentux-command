[Unit]
Description=AgentUX Command Temporal server
Requires=agentux-command-postgres.service agentux-command-nats.service
After=agentux-command-postgres.service agentux-command-nats.service

[Container]
Image=docker.io/temporalio/auto-setup:1.27
ContainerName=agentux-command-temporal
EnvironmentFile=/var/lib/agentux/command/command.env
Environment=DB=postgres12
Environment=DB_PORT=5432
Environment=POSTGRES_USER=agentux
Environment=POSTGRES_PWD_FILE=/run/secrets/postgres-password
Environment=POSTGRES_SEEDS=agentux-command-postgres
Secret=agentux-command-postgres-password,type=env,target=postgres-password
PublishPort=7233:7233
HealthCmd=sh -c 'temporal operator cluster health'
HealthInterval=15s
HealthTimeout=8s
HealthRetries=10

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target

