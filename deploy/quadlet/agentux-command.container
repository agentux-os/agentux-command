[Unit]
Description=AgentUX Command control plane
# PostgreSQL holds all of Command's state. NATS and the object store are
# part of the bundle for what comes next (ADR 0020); Command does not need
# them to run, so their failure does not stop it.
Requires=agentux-command-postgres.service
After=agentux-command-postgres.service
Wants=agentux-command-nats.service agentux-command-object-store.service

[Container]
Image=ghcr.io/agentux-os/agentux-command:0.1.1
ContainerName=agentux-command
Network=agentux-command.network
EnvironmentFile=/var/lib/agentux/command/command.env
Environment=AGENTUX_COMMAND_ADDR=:8080
Environment=AGENTUX_COMMAND_DATABASE_URL=postgres://agentux@agentux-command-postgres:5432/agentux?sslmode=disable
Secret=agentux-command-postgres-password,type=env,target=PGPASSWORD
PublishPort=8080:8080
# Liveness: a Command that stops answering is restarted. Whether its
# database answers is readiness (/readyz), for monitoring and proxies: a
# database outage must not restart Command in a loop.
HealthCmd=curl --fail --silent http://localhost:8080/livez
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target
